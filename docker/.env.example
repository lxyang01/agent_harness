# BillGuard docker-network environment defaults (docker compose 集群内服务地址)。
# 复制为 .env 或导出后使用;宿主机直连测试端口是 127.0.0.1:5433(PG)/ 127.0.0.1:6380(Redis)。
BILLGUARD_PG_DSN=postgresql://billguard:billguard@postgres:5432/billguard
BILLGUARD_REDIS_URL=redis://redis:6379/0
BILLGUARD_BILL_MCP_URL=http://bill-server:8010/mcp
BILLGUARD_WORK_ITEM_MCP_URL=http://work-item-server:8020/mcp
